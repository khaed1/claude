#!/bin/sh
# poactl check|run|pause|resume|stop|start|log [n] — control the PoA worker (runs as user poa-worker).
A=/home/poa-worker/poa-agent
case "$1" in
  check)  echo "timer:  $(systemctl is-active poa-worker.timer) ($(systemctl is-enabled poa-worker.timer 2>/dev/null) at boot), next: $(systemctl show poa-worker.timer -p NextElapseUSecRealtime --value)"
          echo "last cycle: $(systemctl show poa-worker.service -p ExecMainExitTimestamp --value) result=$(systemctl show poa-worker.service -p Result --value)"
          [ -e $A/PAUSE ] && echo "PAUSED (poactl resume to continue)"
          python3 -c "import json;s=json.load(open('$A/state.json'));c=json.load(open('/etc/poa-worker/config.json'));print(f\"address: {s.get('address')} | model spend: \${s['spent_usd']:.3f} of \${c['budget_usd']} | ends {c['end']}\")" 2>/dev/null || echo "no cycle has finished yet"
          grep '"event": "balance"' $A/logs/activity.jsonl 2>/dev/null | tail -n 1 ;;
  run)    systemctl start --no-block poa-worker.service; echo "cycle started; see: poactl log" ;;
  pause)  runuser -u poa-worker -- touch $A/PAUSE; echo "paused (cycles do nothing)" ;;
  resume) rm -f $A/PAUSE; echo resumed ;;
  stop)   systemctl disable --now poa-worker.timer; echo "timer stopped and disabled at boot" ;;
  start)  systemctl enable --now poa-worker.timer; echo started ;;
  log)    tail -n ${2:-20} $A/logs/activity.jsonl ;;
  *) echo "usage: poactl check|run|pause|resume|stop|start|log [n]"; exit 64 ;;
esac
