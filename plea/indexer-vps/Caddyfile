# Caddy in front of the indexer: HTTPS (a free Let's Encrypt certificate, renewed by itself) and only the
# indexer's four paths. Replace indexer.example.com with your hostname. Install as /etc/caddy/Caddyfile.
indexer.example.com {
	request_body {
		max_size 16KB
	}
	@api path /graphql /health /ready /status
	handle @api {
		reverse_proxy 127.0.0.1:42069
	}
	handle {
		respond 404
	}
}
