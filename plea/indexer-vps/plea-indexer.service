# systemd unit for the PLEA indexer, laid out as in VPS.md. Install (as root):
#   cp plea-indexer.service /etc/systemd/system/plea-indexer.service
#   systemctl daemon-reload && systemctl enable --now plea-indexer
#   journalctl -u plea-indexer -f
# A new --schema name means a fresh index (after a code or config change); the old one stays in Postgres.
[Unit]
Description=PLEA indexer (Ponder)
After=network-online.target postgresql.service
Wants=network-online.target
Requires=postgresql.service

[Service]
Type=simple
User=plea-indexer
WorkingDirectory=/opt/plea-indexer/app
EnvironmentFile=/opt/plea-indexer/app/.env.local
ExecStart=/opt/plea-indexer/node/bin/node node_modules/.bin/ponder start --schema plea_v1 --hostname 127.0.0.1 --port 42069
Restart=always
RestartSec=10
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/plea-indexer/app
MemoryMax=1G

[Install]
WantedBy=multi-user.target
